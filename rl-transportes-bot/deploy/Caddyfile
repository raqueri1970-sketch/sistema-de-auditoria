# Telas de Obras & Reformas (Presidente, Financeiro, Contas a pagar, Relatórios) servidas pelo próprio servidor.
# HTTPS automático (Let's Encrypt) no endereço gratuito <ip-com-traços>.sslip.io — não precisa de domínio.
# Só arquivos estáticos: os dados ficam no Supabase, protegidos pelo login do Portal.
{$SITE_HOST} {
	encode gzip
	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "no-referrer"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	redir / /obras/ 302
	root * /srv
	file_server
}
