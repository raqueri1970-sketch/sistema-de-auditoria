+/* ---------- Cache local do arquivo do Portal (desempenho, 12/11/2026) ----------
+   O arquivo do Portal (~13 MB, com todos os módulos) era baixado do zero a cada login e a cada
+   recarga: o link assinado muda toda vez, então o navegador nunca reaproveitava o download.
+   Agora este navegador guarda uma cópia (IndexedDB) junto com a versão do objeto no Storage
+   (eTag + data + tamanho). Na abertura seguinte só consulta a versão (poucos bytes): se for a
+   mesma, abre da cópia; se o arquivo mudou no Storage, baixa de novo e troca a cópia.
+   Se a consulta de versão falhar, baixa como antes (sem cache). Sair do Portal ou acesso negado
+   apagam a cópia. */
+var PORTAL_CACHE_DB='portal_arquivo_cache_v1';
+function portalCacheDB(){
+  return new Promise(function(res){
+    try{var r=indexedDB.open(PORTAL_CACHE_DB,1);
+      r.onupgradeneeded=function(){r.result.createObjectStore('arq')};
+      r.onsuccess=function(){res(r.result)};r.onerror=function(){res(null)};r.onblocked=function(){res(null)};
+    }catch(e){res(null)}
+  });
+}
+async function portalCacheLer(){
+  var db=await portalCacheDB();if(!db)return null;
+  return new Promise(function(res){
+    try{var q=db.transaction('arq','readonly').objectStore('arq').get(FILE_PATH);
+      q.onsuccess=function(){res(q.result||null)};q.onerror=function(){res(null)};
+    }catch(e){res(null)}
+  });
+}
+async function portalCacheGravar(versao,html){
+  var db=await portalCacheDB();if(!db)return;
+  try{db.transaction('arq','readwrite').objectStore('arq').put({versao:versao,html:html,em:Date.now()},FILE_PATH)}catch(e){}
+}
+function portalCacheApagar(){try{indexedDB.deleteDatabase(PORTAL_CACHE_DB)}catch(e){}}
+async function versaoDoPortalNoStorage(){
+  try{
+    var r=await sb.storage.from(BUCKET).list('',{search:FILE_PATH,limit:20});
+    if(r.error||!r.data)return null;
+    var o=r.data.find(function(x){return x&&x.name===FILE_PATH});
+    if(!o)return null;
+    var m=o.metadata||{};
+    var partes=[m.eTag||'',o.updated_at||m.lastModified||'',m.size||m.contentLength||''];
+    return partes.join('')?partes.join('|'):null;
+  }catch(e){return null}
+}
+async function baixarArquivoDoPortal(){
+  var versao=await versaoDoPortalNoStorage();
+  if(versao){
+    var c=await portalCacheLer();
+    if(c&&c.versao===versao&&c.html){console.info('[Portal] arquivo aberto da cópia local (versão '+versao+')');return {html:c.html};}
+  }
+  var res=await sb.storage.from(BUCKET).createSignedUrl(FILE_PATH,3600);
+  if(res.error)return {erro:'Erro ao abrir o portal: '+res.error.message};
+  var fileRes=await fetch(res.data.signedUrl);
+  if(!fileRes.ok)return {erro:'Erro ao baixar o portal (status '+fileRes.status+')'};
+  var html=await fileRes.text();
+  if(versao)portalCacheGravar(versao,html);
+  return {html:html};
+}
