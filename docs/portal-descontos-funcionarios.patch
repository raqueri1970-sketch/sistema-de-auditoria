+.df-sug button{display:flex;width:100%;justify-content:space-between;gap:12px;align-items:center;background:none;border:0;color:var(--txt);text-align:left;padding:8px 10px;border-radius:10px;cursor:pointer;font:13px Inter,sans-serif}
+.df-sug button:hover,.df-sug button.on{background:var(--azul3)}
+.df-sug .v{color:var(--mut);font-size:12px;white-space:nowrap}
+
+.df-filtros{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:10px;align-items:end;margin-top:12px}
+.df-filtros .fbtn{display:flex;gap:8px}
+.df-ativo{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
+.df-ativo .chip button{background:none;border:0;color:inherit;cursor:pointer;padding:0 0 0 4px;font-weight:800}
+
+.df-abas{display:flex;gap:6px;flex-wrap:wrap;margin:16px 0 4px;position:sticky;top:0;z-index:20;background:var(--bg);padding:8px 0}
+.df-abas button{font:700 13px Inter,sans-serif;background:var(--card);border:1px solid var(--linha);color:var(--txt2);border-radius:10px;padding:9px 14px;cursor:pointer}
+.df-abas button.on{background:#1e3a8a;border-color:#3b82f6;color:#fff}
+.df-abas .cont{background:rgba(239,68,68,.25);color:var(--bad);border-radius:999px;padding:0 7px;margin-left:5px;font-size:11px}
+
+/* cards inteligentes */
+.df-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:12px}
+.df-card{position:relative;text-align:left;font:inherit;color:inherit;background:linear-gradient(180deg,var(--card),#0d1527);border:1px solid var(--linha);border-left:4px solid var(--azul2);border-radius:14px;padding:14px 14px 12px;cursor:pointer;box-shadow:var(--sombra);transition:transform .12s,border-color .12s}
+.df-card:hover{transform:translateY(-1px);border-color:var(--linha2)}
+.df-card.ok{border-left-color:var(--okb)}.df-card.warn{border-left-color:var(--warnb)}.df-card.bad{border-left-color:var(--badb)}.df-card.roxo{border-left-color:#a78bfa}.df-card.neu{border-left-color:#64748b}
+.df-card .t{font-size:11.5px;font-weight:800;color:var(--txt2);text-transform:uppercase;letter-spacing:.05em;line-height:1.3;padding-right:44px}
+.df-card .n{font-size:26px;font-weight:800;margin:6px 0 2px;letter-spacing:-.02em}
+.df-card.bad .n{color:#fecaca}.df-card.warn .n{color:#fde68a}.df-card.ok .n{color:#bbf7d0}
+.df-card .d{font-size:12px;color:var(--mut);line-height:1.4}
+.df-card .cmp{font-size:11.5px;margin-top:6px;font-weight:700}
+.df-card .cmp.up{color:var(--bad)}.df-card .cmp.down{color:var(--ok)}.df-card .cmp.eq{color:var(--mut)}
+.df-card .base{font-size:10.5px;color:#7d8bab;margin-top:6px}
+.df-card .abrir{position:absolute;top:12px;right:12px;font-size:10.5px;color:var(--azul);font-weight:800}
+
+.df-grid2{display:grid;grid-template-columns:1.4fr 1fr;gap:12px}
+@media(max-width:900px){.df-grid2{grid-template-columns:1fr}}
+
+/* tabelas */
+.tw{overflow:auto;border:1px solid var(--linha);border-radius:12px;max-height:70vh}
+table{width:100%;border-collapse:collapse;font-size:12.5px}
+th{position:sticky;top:0;background:#13213f;color:#cfe0ff;text-align:left;font-size:11px;text-transform:uppercase;letter-spacing:.05em;padding:9px 10px;border-bottom:1px solid var(--linha2);white-space:nowrap;cursor:pointer;user-select:none;z-index:1}
+td{padding:8px 10px;border-bottom:1px solid var(--linha);vertical-align:top}
+tbody tr:nth-child(even) td{background:rgba(255,255,255,.015)}
+tbody tr.cl{cursor:pointer}tbody tr.cl:hover td{background:var(--azul3)}
+td.r,th.r{text-align:right;white-space:nowrap}td.c,th.c{text-align:center}
+tfoot td{position:sticky;bottom:0;background:#13213f;font-weight:800;color:#fff;border-top:2px solid var(--azul2)}
+.nw{white-space:nowrap}.mut{color:var(--mut)}.b{font-weight:700}
+.vbad{color:var(--bad);font-weight:700}.vwarn{color:var(--warn);font-weight:700}.vok{color:var(--ok);font-weight:700}
+.df-pag{display:flex;gap:8px;align-items:center;justify-content:space-between;margin-top:8px;font-size:12px;color:var(--mut);flex-wrap:wrap}
+.df-tot{display:flex;gap:8px;flex-wrap:wrap;margin:8px 0}
+.df-tot div{background:var(--card2);border:1px solid var(--linha);border-radius:10px;padding:7px 11px;font-size:12px;color:var(--mut)}
+.df-tot b{display:block;color:#fff;font-size:15px}
+
+/* barras */
+.df-barras{display:flex;align-items:flex-end;gap:6px;height:190px;padding:10px 4px 0}
+.df-barras .col{flex:1;display:flex;flex-direction:column;justify-content:flex-end;align-items:center;gap:4px;min-width:0;cursor:pointer}
+.df-barras .pilha{width:100%;max-width:46px;display:flex;flex-direction:column-reverse;border-radius:6px 6px 2px 2px;overflow:hidden}
+.df-barras .pilha span{display:block}
+.df-barras .rot{font-size:10.5px;color:var(--mut)}
+.df-barras .val{font-size:10px;color:var(--txt2);white-space:nowrap}
+.df-leg{display:flex;gap:12px;flex-wrap:wrap;font-size:11.5px;color:var(--mut);margin-top:8px}
+.df-leg i{display:inline-block;width:10px;height:10px;border-radius:3px;margin-right:5px;vertical-align:-1px}
+.df-hbar{display:grid;grid-template-columns:minmax(110px,180px) 1fr auto;gap:8px;align-items:center;font-size:12px;margin:5px 0;cursor:pointer}
+.df-hbar .tr{background:var(--card3);border-radius:6px;height:12px;overflow:hidden}.df-hbar .tr span{display:block;height:100%;background:var(--azul2)}
+
+/* modal */
+.df-modal{position:fixed;inset:0;z-index:1000;background:rgba(2,6,15,.78);display:flex;align-items:flex-start;justify-content:center;padding:max(14px,env(safe-area-inset-top)) 10px 14px;overflow:auto}
+.df-mcx{background:#0c1426;border:1px solid var(--linha2);border-radius:16px;width:min(1280px,100%);box-shadow:0 30px 80px -20px #000;display:flex;flex-direction:column;max-height:calc(100vh - 28px)}
+.df-mtopo{display:flex;justify-content:space-between;align-items:flex-start;gap:10px;padding:14px 16px;border-bottom:1px solid var(--linha);flex-wrap:wrap}
+.df-mtopo h3{margin:0;font-size:16px}
+.df-mcorpo{padding:12px 16px 16px;overflow:auto}
+.df-ficha{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin:6px 0 12px}
+.df-ficha div{background:var(--card2);border:1px solid var(--linha);border-radius:10px;padding:8px 10px;font-size:11.5px;color:var(--mut)}
+.df-ficha b{display:block;color:#fff;font-size:14px;margin-top:2px}
+.df-motivos{margin:0 0 12px;padding-left:18px;font-size:13px}.df-motivos li{margin:3px 0}
+
+.df-up{border:2px dashed var(--linha2);border-radius:16px;padding:26px;text-align:center;cursor:pointer;background:rgba(59,130,246,.04)}
+.df-up.drag{border-color:var(--azul2);background:var(--azul3)}
+.df-arqs{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:10px;margin-top:12px}
+.df-arqs>div{background:var(--card2);border:1px solid var(--linha);border-radius:12px;padding:10px 12px;font-size:12.5px}
+.df-barra{height:8px;background:var(--card3);border-radius:99px;overflow:hidden;margin-top:10px}.df-barra span{display:block;height:100%;background:var(--okb);width:0;transition:width .2s}
+
+.login{max-width:380px;margin:60px auto}.login .card>*{margin-bottom:10px}.err{color:var(--bad);font-size:12.5px;min-height:16px}
+#toast{position:fixed;bottom:18px;left:50%;transform:translateX(-50%);background:#111c33;border:1px solid var(--linha2);color:#fff;padding:10px 16px;border-radius:12px;z-index:2000;display:none;max-width:92vw;box-shadow:0 10px 30px #000;font-size:13px}
+.vazio{text-align:center;color:var(--mut);padding:40px 16px}
+@media(max-width:640px){body{padding-left:12px;padding-right:12px}.df-card .n{font-size:22px}h1{font-size:18px}}
diff --git a/descontos-funcionarios/index.html b/descontos-funcionarios/index.html
new file mode 100644
index 0000000..d5860a7
--- /dev/null
+++ b/descontos-funcionarios/index.html
@@ -0,0 +1,90 @@
+<!doctype html>
+<html lang="pt-BR">
+<head>
+<meta charset="utf-8">
+<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
+<title>Descontos de Funcionários</title>
+<meta name="theme-color" content="#070b16">
+<link rel="preconnect" href="https://fonts.googleapis.com">
+<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
+<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2.45.4/dist/umd/supabase.min.js"></script>
+<script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
+<script src="nucleo.js?v=20261116-1"></script>
+<link rel="stylesheet" href="estilo.css?v=20261116-1">
+</head>
+<body>
+
+<div id="vLogin" class="hidden login">
+  <h1>🏷️ Descontos de Funcionários</h1>
+  <div class="sub" style="margin-bottom:14px">Entre com o seu usuário do Portal Esposende</div>
+  <div class="card">
+    <div><label for="lEmail">E-mail</label><input id="lEmail" type="email" autocomplete="username"></div>
+    <div><label for="lSenha">Senha</label><input id="lSenha" type="password" autocomplete="current-password" onkeydown="if(event.key==='Enter')entrar()"></div>
+    <div id="lErr" class="err"></div>
+    <button class="btn pri" style="width:100%" onclick="entrar()">Entrar</button>
+  </div>
+</div>
+
+<div id="vSem" class="hidden card vazio" style="max-width:560px;margin:40px auto">
+  Este módulo é restrito à Controladoria, Administração e Compras.<br>Peça liberação ao administrador do Portal.
+</div>
+
+<div id="vApp" class="hidden">
+  <header class="card">
+    <div class="df-topo">
+      <div>
+        <h1>🏷️ Descontos de Funcionários</h1>
+        <div class="sub">Auditoria de alçadas · quem recebeu desconto, quem concedeu e o que foge da regra</div>
+      </div>
+      <div class="df-acoes">
+        <button class="btn pri" onclick="abrirAba('carregar')">📂 Carregar arquivos</button>
+        <button class="btn" onclick="relatorioExecutivo()">🖨 Relatório executivo</button>
+        <button class="btn" onclick="excelLancamentos()">⬇ Excel</button>
+        <button class="btn" onclick="recarregarNuvem(true)">↻ Atualizar</button>
+      </div>
+    </div>
+    <div class="df-status" id="status"></div>
+    <div id="avisos"></div>
+    <div class="df-busca">
+      <input id="busca" type="search" autocomplete="off" placeholder="Pesquisa inteligente: nome do funcionário ou cliente, vendedor, nº da venda, loja, regional ou produto…" aria-label="Pesquisa inteligente">
+      <div id="sug" class="df-sug hidden"></div>
+    </div>
+    <div class="df-filtros">
+      <div><label for="fDe">De</label><input type="date" id="fDe"></div>
+      <div><label for="fAte">Até</label><input type="date" id="fAte"></div>
+      <div><label for="fReg">Regional</label><select id="fReg"><option value="">Todas</option></select></div>
+      <div><label for="fLoja">Loja</label><select id="fLoja"><option value="">Todas</option></select></div>
+      <div><label for="fSit">Quem recebeu</label><select id="fSit"><option value="">Todos</option></select></div>
+      <div><label for="fCat">Classificação</label><select id="fCat"><option value="">Todas (sem arredondamento)</option></select></div>
+      <div class="fbtn"><button class="btn" onclick="limparFiltros()">Limpar filtros</button></div>
+    </div>
+    <div class="df-ativo" id="ativos"></div>
+  </header>
+
+  <nav class="df-abas" id="abas">
+    <button data-a="painel" class="on">Painel</button>
+    <button data-a="suspeitas">Suspeitas <span class="cont" id="cSusp"></span></button>
+    <button data-a="pessoas">Por pessoa</button>
+    <button data-a="vendedores">Por vendedor</button>
+    <button data-a="lojas">Por loja / regional</button>
+    <button data-a="lanc">Lançamentos</button>
+    <button data-a="relatorios">Relatórios</button>
+    <button data-a="carregar">Carregar arquivos</button>
+  </nav>
+
+  <main id="conteudo"><div class="vazio">Carregando a base da nuvem…</div></main>
+</div>
+
+<div id="modal" class="df-modal hidden" role="dialog" aria-modal="true" aria-labelledby="mTit" onclick="if(event.target===this)fecharModal()">
+  <div class="df-mcx">
+    <div class="df-mtopo">
+      <div><h3 id="mTit"></h3><div class="sub" id="mSub"></div></div>
+      <div class="df-acoes" id="mAcoes"></div>
+    </div>
+    <div class="df-mcorpo" id="mCorpo"></div>
+  </div>
+</div>
+<div id="toast"></div>
+<script src="app.js?v=20261116-1"></script>
+</body>
+</html>
